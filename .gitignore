# Plugin data (user-specific state)
.data/
.gjc/
*.local.json

# OS
.DS_Store
Thumbs.db

# Node
node_modules/

# Build artifacts
# ui/dist is deliberately NOT ignored: plugins are installed by copying this repo, and there is no
# build step on the user's machine. Ignoring it shipped a viewer that pointed at an empty directory.
# Rebuild with `cd ui && npm install && npm run build` and commit the result when the UI changes.
*.tsbuildinfo

# Runtime artifacts
.captures/
.claude/agent-memory/
.claude/handoffs/
.claude/last30days.env
.claude/settings.local.json
.superpowers/
.omo/

# Test snapshots
tests/skill-tests/

# Temp
*.tmp
*.log

# Codex test artifacts (numbered dirs at root)
/[0-9]*/
