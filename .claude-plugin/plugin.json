{
  "name": "scc",
  "description": "PDCA control loop for knowledge work on Claude Code. 18 skills, job-labeled agents, length floors, false-consensus review, unblock for gated URLs. Not a second agent OS.",
  "version": "2.2.0",
  "author": {
    "name": "Unclejobs",
    "email": "parkeungje@gmail.com"
  },
  "homepage": "https://github.com/unclejobs-ai/second-claude-code",
  "repository": "https://github.com/unclejobs-ai/second-claude-code",
  "license": "MIT",
  "keywords": [
    "knowledge-work",
    "pdca",
    "research",
    "writing",
    "strategy",
    "review",
    "workflow",
    "second-brain",
    "automation",
    "web-fetch",
    "anti-block",
    "scraping"
  ],
  "mcpServers": {
    "pdca-state": {
      "type": "stdio",
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/mcp/pdca-state-server.mjs"]
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["@playwright/mcp@0.0.78"]
    },
    "mmbridge": {
      "type": "stdio",
      "command": "npx",
      "args": ["@mmbridge/mcp@0.7.3"],
      "optional": true
    }
  }
}
