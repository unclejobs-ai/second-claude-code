{
  "name": "scc",
  "description": "PDCA-native Knowledge Work OS with Cross-Plugin Orchestrator — 15 skills, 18 commands, 17 Pokemon agents, 31 MCP tools. Settles a fork into a decision standard your project keeps, checks artifacts against those standards, and bars whoever helped make something from passing it. Artifact Viewer, cycle memory, code engineering lane, and a zero-key adaptive fetch chain for hostile URLs.",
  "version": "3.0.0",
  "author": {
    "name": "Unclejobs",
    "email": "parkeungje@gmail.com"
  },
  "homepage": "https://github.com/unclejobs-ai/second-claude-code",
  "repository": "https://github.com/unclejobs-ai/second-claude-code",
  "license": "MIT",
  "keywords": [
    "knowledge-work",
    "pdca",
    "research",
    "writing",
    "strategy",
    "review",
    "workflow",
    "second-brain",
    "automation",
    "web-fetch",
    "anti-block",
    "scraping"
  ],
  "mcpServers": {
    "pdca-state": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/mcp/pdca-state-server.mjs"
      ]
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@playwright/mcp@0.0.78",
        "--headless",
        "--isolated"
      ]
    },
    "mmbridge": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@mmbridge/mcp@0.7.3"
      ],
      "optional": true
    }
  }
}
