  "keywords": [
    "knowledge-work",
    "godhands",
    "pdca",
    "research",
    "writing",
    "strategy",
    "review",
    "workflow",
    "second-brain",
    "automation",
    "web-fetch",
    "anti-block",
    "scraping"
  ],
  "mcpServers": {
    "pdca-state": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/mcp/pdca-state-server.bundle.mjs"
      ]
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@playwright/mcp@0.0.79",
        "--headless",
        "--isolated"
      ],
      "optional": true
    },
    "mmbridge": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@mmbridge/mcp@0.7.3"
      ],
      "optional": true
    }
  }
}
