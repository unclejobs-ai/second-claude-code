{
  "name": "scc",
  "description": "PDCA workflow toolkit for Claude Code: 15 skills, 18 commands, 17 agents, 9 lifecycle hook events, and 31 MCP tools. Includes decision standards, independent review gates, artifact history, and advisory cross-plugin discovery.",
  "version": "3.0.2",
  "author": {
    "name": "Unclejobs",
    "email": "parkeungje@gmail.com"
  },
  "homepage": "https://github.com/unclejobs-ai/second-claude-code",
  "repository": "https://github.com/unclejobs-ai/second-claude-code",
  "license": "MIT",
  "keywords": [
    "knowledge-work",
    "pdca",
    "research",
    "writing",
    "strategy",
    "review",
    "workflow",
    "second-brain",
    "automation",
    "web-fetch",
    "anti-block",
    "scraping"
  ],
  "mcpServers": {
    "pdca-state": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/mcp/pdca-state-server.bundle.mjs"
      ]
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@playwright/mcp@0.0.79",
        "--headless",
        "--isolated"
      ],
      "optional": true
    },
    "mmbridge": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@mmbridge/mcp@0.7.3"
      ],
      "optional": true
    }
  }
}
