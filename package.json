{
  "name": "scc",
  "version": "3.1.1",
  "description": "God Hands — extra hands that find, analyze, plan, decompose, benchmark, and improve. The AI workflow that does not skip Check. 16 skills, 19 commands, 17 agents, and 3 MCP servers",
  "type": "module",
  "private": true,
  "scripts": {
    "build:core": "tsc -p packages/core/tsconfig.json",
    "build:mcp": "node scripts/build-mcp.mjs",
    "test": "node --test",
    "test:core": "npm run verify:core-release && node --test packages/core/test/*.test.mjs",
    "verify:core-release": "node scripts/verify-core-release.mjs",
    "release:core": "node scripts/release-core.mjs",
    "verify:core-dist": "node scripts/verify-core-dist.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  }
}
