{
  "name": "autopilot",
  "description": "End-to-end workflow: research → analyze → write → review → refine.",
  "steps": [
    {
      "skill": "/scc:research",
      "args": "\"{{topic}}\" --depth medium",
      "output": "research-brief.md",
      "on_fail": "abort"
    },
    {
      "skill": "/scc:analyze",
      "args": "--framework swot --with-research",
      "input_from": "research-brief.md",
      "output": "analysis.md",
      "on_fail": "abort"
    },
    {
      "skill": "/scc:write",
      "args": "--format report --voice expert --skip-research --skip-review",
      "input_from": "analysis.md",
      "output": "draft.md",
      "on_fail": "abort"
    },
    {
      "skill": "/scc:review",
      "args": "--preset content",
      "input_from": "draft.md",
      "output": "review-report.md",
      "on_fail": "abort"
    },
    {
      "skill": "/scc:refine",
      "args": "--max 3 --target APPROVED",
      "input_from": ["draft.md", "review-report.md"],
      "output": "final.md",
      "on_fail": "retry"
    }
  ]
}
